source("~/GitHub/Crayfish_Report/src/04_link_vhag-wvlc.R")
dataset_final$distance_linked
dataset_final$link_status
print(table(dataset_final$link_status[dataset_final$link_status]))
cat(paste0("Succesvol gekoppeld: ", sum(dataset_final$link_status), "\n"))
cat(paste0("Totaal records: ", nrow(dataset_final), "\n"))
dataset_final <- dataset_final %>%
mutate(
# Maak de boolean die je print-script verwacht
valid_link = link_status != "niet gekoppeld",
# Maak de methode-kolom die je print-script verwacht
link_method = link_status
)
# Stats printen
cat(paste0("Totaal records: ", nrow(dataset_final), "\n"))
cat(paste0("Succesvol gekoppeld: ", sum(dataset_final$valid_link), "\n"))
print(table(dataset_final$link_method[dataset_final$valid_link]))
print(table(dataset_final$link_method[dataset_final$link_method]))
print(table(dataset_final$valid_link[dataset_final$link_method]))
library(dplyr)
overzicht <- dataset_final %>%
count(link_method) %>%
mutate(percentage = round(n / sum(n) * 100, 1))
