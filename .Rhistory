library(tidyverse)
library(fs)
library(stringr)
library(here)
# ==============================================================================
# 1. INSTELLINGEN & VOORBEREIDING
# ==============================================================================
input_csv_pad <- "alle_bestanden_overzicht.csv"
config_pad    <- "./src/config.R"
script_dir    <- "src"
# Controleer bestanden
if (!file.exists(input_csv_pad)) stop(paste("❌ Bestand niet gevonden:", input_csv_pad))
if (!file.exists(config_pad)) stop(paste("❌ Bestand niet gevonden:", config_pad))
if (!dir.exists(script_dir)) stop(paste("❌ Map niet gevonden:", script_dir))
# HULPFUNCTIE: Normaliseer paden voor vergelijking (kleine letters, forward slashes)
norm_path <- function(p) {
p %>% path_abs() %>% path_norm() %>% tolower()
}
# Laad bestandenlijst
df_files <- read_csv(input_csv_pad, show_col_types = FALSE) %>%
mutate(match_path = norm_path(path)) # Maak een sleutel voor vergelijking
message(paste("📂 Aantal bestanden in CSV:", nrow(df_files)))
# ==============================================================================
# 2. CONFIG VARIABELEN UITLEZEN (De veilige methode)
# ==============================================================================
message("⚙️ Config inlezen...")
env_config <- new.env()
wd_orig <- getwd()
# Probeer here() veilig te stellen of terug te vallen op getwd()
root_path <- tryCatch(here(), error = function(e) getwd())
setwd(root_path)
source(config_pad, local = env_config)
setwd(wd_orig)
raw_list <- as.list(env_config)
# Filter: alleen tekst-variabelen (paden)
valid_entries <- sapply(raw_list, function(x) {
is.character(x) && length(x) == 1
})
config_map <- tibble(
var_name = names(raw_list)[valid_entries],
path_value = unlist(raw_list[valid_entries])
) %>%
# Filter lege paden of NA
filter(!is.na(path_value), path_value != "") %>%
mutate(match_path = norm_path(path_value))
message(paste("   -> Aantal paden gevonden in config:", nrow(config_map)))
# ==============================================================================
# 3. LOGICA VOOR INPUT/OUTPUT DETECTIE
# ==============================================================================
detect_usage_type <- function(script_content, var_name) {
# Zoek regels met de variabele
lines_with_var <- script_content[str_detect(script_content, fixed(var_name))]
if (length(lines_with_var) == 0) return(NA)
# Uitgebreidere patronen
write_patterns <- c("write", "save", "ggsave", "png", "pdf", "st_write", "output", "export")
read_patterns  <- c("read", "load", "source", "st_read", "input", "import")
is_output <- any(str_detect(lines_with_var, paste(write_patterns, collapse = "|")))
is_input  <- any(str_detect(lines_with_var, paste(read_patterns, collapse = "|")))
if (is_output) return("Output")
if (is_input) return("Input_config")
return("Input_config") # Fallback
}
# ==============================================================================
# 4. LOOP OVER DE SCRIPTS
# ==============================================================================
# Haal scripts op. Als de regex te streng is, pas hem hier aan.
# Nu: Start met 2 cijfers, eindigt op .R
scripts <- dir_ls(script_dir, regexp = "/\\d{2}_.*\\.R$")
if (length(scripts) == 0) {
warning("⚠️ Geen scripts gevonden in 'src' die beginnen met 2 cijfers! (bijv. 01_script.R)")
# Fallback: probeer alle R files als check
scripts <- dir_ls(script_dir, glob = "*.R")
message(paste("   -> Fallback: gevonden R files:", length(scripts)))
} else {
message(paste("📜 Aantal relevante scripts gevonden:", length(scripts)))
}
df_result <- df_files
# Loop
for (script_path in scripts) {
script_name <- path_file(script_path)
script_content <- readLines(script_path, warn = FALSE)
# Maak lege kolom
col_data <- rep(NA_character_, nrow(df_result))
found_count <- 0
# A. Check Config Variabelen
# Welke variabelen uit de config komen voor in de tekst van dit script?
vars_in_script <- config_map %>%
filter(sapply(var_name, function(v) any(str_detect(script_content, fixed(v)))))
if (nrow(vars_in_script) > 0) {
for (i in 1:nrow(vars_in_script)) {
v_name <- vars_in_script$var_name[i]
v_path_match <- vars_in_script$match_path[i]
usage <- detect_usage_type(script_content, v_name)
# Match op de genormaliseerde paden
match_idx <- which(df_result$match_path == v_path_match)
if (length(match_idx) > 0) {
col_data[match_idx] <- usage
found_count <- found_count + length(match_idx)
}
}
}
# B. Check Hardcoded bestandsnamen (optioneel, als vangnet)
# (Hier kijken we alleen naar bestandsnaam in tekst)
# ... (overgeslagen voor beknoptheid en focus op config, voeg toe indien nodig)
# Voeg kolom toe
df_result[[script_name]] <- col_data
# Kleine status update
if(found_count > 0) {
message(paste("   ✅", script_name, ":", found_count, "bestanden gekoppeld."))
} else {
message(paste("   ⚪", script_name, ": Geen matches gevonden."))
}
}
# ==============================================================================
# 5. OPSLAAN
# ==============================================================================
# Verwijder hulpkolom
final_table <- df_result %>% select(-match_path)
# Filter op regels die daadwerkelijk ergens gebruikt worden (voor preview)
used_files_preview <- final_table %>%
filter(if_any(ends_with(".R"), ~ !is.na(.)))
print("--- PREVIEW VAN GEMATCHTE BESTANDEN ---")
print(head(used_files_preview %>% select(path, any_of(basename(scripts)))))
write_csv(final_table, "data_lineage_matrix_v2.csv")
library(tidyverse)
library(fs)
library(stringr)
library(here)
# ==============================================================================
# 1. INSTELLINGEN & VOORBEREIDING
# ==============================================================================
input_csv_pad <- "alle_bestanden_overzicht.csv"
config_pad    <- "./src/config.R"  # Zoals aangegeven in jouw structuur
script_dir    <- "src"
# Controleer bestanden
if (!file.exists(input_csv_pad)) stop(paste("❌ Bestand niet gevonden:", input_csv_pad))
if (!file.exists(config_pad)) stop(paste("❌ Bestand niet gevonden:", config_pad))
if (!dir.exists(script_dir)) stop(paste("❌ Map niet gevonden:", script_dir))
# HULPFUNCTIE: Normaliseer paden voor vergelijking (kleine letters, forward slashes)
norm_path <- function(p) {
p %>% path_abs() %>% path_norm() %>% tolower()
}
# Laad bestandenlijst
df_files <- read_csv(input_csv_pad, show_col_types = FALSE) %>%
mutate(match_path = norm_path(path)) # Maak een sleutel voor vergelijking
message(paste("📂 Aantal bestanden in CSV:", nrow(df_files)))
# ==============================================================================
# 2. CONFIG VARIABELEN UITLEZEN
# ==============================================================================
message("⚙️ Config inlezen...")
env_config <- new.env()
wd_orig <- getwd()
# Probeer de root te vinden voor here()
root_path <- tryCatch(here(), error = function(e) getwd())
# We zetten de working directory tijdelijk goed zodat source() en here() werken
setwd(root_path)
source(config_pad, local = env_config)
setwd(wd_orig)
raw_list <- as.list(env_config)
# Filter: alleen tekst-variabelen (paden) die 1 element bevatten
valid_entries <- sapply(raw_list, function(x) {
is.character(x) && length(x) == 1
})
config_map <- tibble(
var_name = names(raw_list)[valid_entries],
path_value = unlist(raw_list[valid_entries])
) %>%
# Filter lege paden of NA
filter(!is.na(path_value), path_value != "") %>%
mutate(match_path = norm_path(path_value))
message(paste("   -> Aantal paden gevonden in config:", nrow(config_map)))
# ==============================================================================
# 3. LOGICA VOOR INPUT/OUTPUT DETECTIE (VERBETERD)
# ==============================================================================
detect_usage_type <- function(script_content, var_name) {
# Zoek regels waar de variabele in voorkomt
lines_with_var <- script_content[str_detect(script_content, fixed(var_name))]
if (length(lines_with_var) == 0) return(NA)
# Uitgebreide patronen (case-insensitive door (?i))
# "write" dekt: write.csv, write_csv, writeLines, st_write, etc.
write_patterns <- c("write", "save", "ggsave", "png", "pdf",
"st_write", "output", "export", "fwrite", "sink", "cat")
read_patterns  <- c("read", "load", "source", "st_read", "input", "import")
# Check of één van de patronen voorkomt in de regels (negeer hoofdletters)
is_output <- any(str_detect(lines_with_var, regex(paste(write_patterns, collapse = "|"), ignore_case = TRUE)))
is_input  <- any(str_detect(lines_with_var, regex(paste(read_patterns, collapse = "|"), ignore_case = TRUE)))
if (is_output) return("Output")
if (is_input) return("Input_config")
return("Input_config") # Fallback (als variabele wordt gebruikt, is het meestal input)
}
# ==============================================================================
# 4. LOOP OVER DE SCRIPTS
# ==============================================================================
# Regex aangepast voor cross-platform (zowel / als \ worden geaccepteerd voor de map)
# Zoekt naar bestanden die beginnen met 2 cijfers in de script_dir
scripts <- dir_ls(script_dir, regexp = "[\\\\/]\\d{2}_.*\\.R$")
if (length(scripts) == 0) {
warning("⚠️ Geen scripts gevonden in 'src' die beginnen met 2 cijfers! (bijv. 01_script.R)")
# Fallback: probeer alle R files
scripts <- dir_ls(script_dir, glob = "*.R")
message(paste("   -> Fallback: alle gevonden R files:", length(scripts)))
} else {
message(paste("📜 Aantal relevante scripts gevonden:", length(scripts)))
}
df_result <- df_files
# Loop door elk script
for (script_path in scripts) {
script_name <- path_file(script_path)
script_content <- readLines(script_path, warn = FALSE)
# Maak lege kolom voor dit script
col_data <- rep(NA_character_, nrow(df_result))
found_count <- 0
# A. Check Config Variabelen
# Welke variabelen uit de config komen voor in de tekst van dit script?
vars_in_script <- config_map %>%
filter(sapply(var_name, function(v) any(str_detect(script_content, fixed(v)))))
if (nrow(vars_in_script) > 0) {
for (i in 1:nrow(vars_in_script)) {
v_name <- vars_in_script$var_name[i]
v_path_match <- vars_in_script$match_path[i]
# Bepaal Input of Output (nu met verbeterde write detectie)
usage <- detect_usage_type(script_content, v_name)
# Zoek de corresponderende rij in de bestandenlijst
match_idx <- which(df_result$match_path == v_path_match)
if (length(match_idx) > 0) {
col_data[match_idx] <- usage
found_count <- found_count + length(match_idx)
}
}
}
# Voeg kolom toe aan dataframe
df_result[[script_name]] <- col_data
# Status update
if(found_count > 0) {
message(paste("   ✅", script_name, ":", found_count, "bestanden gekoppeld."))
} else {
message(paste("   ⚪", script_name, ": Geen matches gevonden."))
}
}
# ==============================================================================
# 5. OPSLAAN
# ==============================================================================
# Verwijder hulpkolom
final_table <- df_result %>% select(-match_path)
# Opslaan
write_csv(final_table, "data_lineage_matrix_v2.csv")
message("\n✅ Klaar! Bestand opgeslagen als 'data_lineage_matrix_v2.csv'")
# Preview tonen
used_files_preview <- final_table %>%
filter(if_any(ends_with(".R"), ~ !is.na(.)))
print("--- PREVIEW ---")
print(head(used_files_preview %>% select(path, any_of(basename(scripts)))))
