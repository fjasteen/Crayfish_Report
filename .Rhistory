library(tidyverse)
library(fs)
library(stringr)
library(here)
# ==============================================================================
# 1. INSTELLINGEN & VOORBEREIDING
# ==============================================================================
# Paden
input_csv_pad <- "alle_bestanden_overzicht.csv" # Je bestand uit de vorige stap
config_pad    <- "./src/config.R"
script_dir    <- "src"
# Controleer of input bestaat
if (!file.exists(input_csv_pad)) stop("Kan de CSV met bestanden niet vinden!")
if (!file.exists(config_pad)) stop("Kan config.R niet vinden!")
# Laad de CSV met bestanden en maak paden absoluut voor correcte vergelijking
df_files <- read_csv(input_csv_pad, show_col_types = FALSE) %>%
mutate(abs_path = path_abs(path))
# ==============================================================================
# 2. CONFIG VARIABELEN UITLEZEN
# ==============================================================================
# We sourcen de config in een aparte environment om de variabelenamen
# aan hun waarden (paden) te koppelen zonder je huidige sessie te vervuilen.
env_config <- new.env()
# Hack: here() werkt soms niet goed in source(), we dwingen de root
wd_orig <- getwd()
setwd(here())
source(config_pad, local = env_config)
setwd(wd_orig)
# Maak een lookup tabel: VariabeleNaam <-> AbsoluutPad
config_map <- as.list(env_config) %>%
as_tibble() %>%
pivot_longer(everything(), names_to = "var_name", values_to = "path_value") %>%
# Filter alleen strings (paden) en negeer functies/andere objecten
filter(sapply(path_value, is.character)) %>%
filter(length(path_value) == 1) %>% # Alleen enkelvoudige paden
mutate(path_abs = path_abs(path_value))
library(tidyverse)
library(fs)
library(stringr)
library(here)
# ==============================================================================
# 1. INSTELLINGEN & VOORBEREIDING
# ==============================================================================
# Paden
input_csv_pad <- "alle_bestanden_overzicht.csv" # Je bestand uit de vorige stap
config_pad    <- "./src/config.R"
script_dir    <- "src"
# Controleer of input bestaat
if (!file.exists(input_csv_pad)) stop("Kan de CSV met bestanden niet vinden!")
if (!file.exists(config_pad)) stop("Kan config.R niet vinden!")
# Laad de CSV met bestanden en maak paden absoluut voor correcte vergelijking
df_files <- read_csv(input_csv_pad, show_col_types = FALSE) %>%
mutate(abs_path = path_abs(path))
# ==============================================================================
# 2. CONFIG VARIABELEN UITLEZEN (VERBETERD)
# ==============================================================================
env_config <- new.env()
wd_orig <- getwd()
setwd(here())
source(config_pad, local = env_config)
setwd(wd_orig)
# Zet om naar een lijst
raw_list <- as.list(env_config)
# Filter: behoud ALLEEN variabelen die tekst zijn (character) én exact 1 item lang zijn.
# Dit filtert automatisch functies, ggplot-objecten en lijsten met meerdere items weg.
valid_entries <- sapply(raw_list, function(x) {
is.character(x) && length(x) == 1
})
# Maak nu pas de dataframe met de gefilterde lijst
config_map <- tibble(
var_name = names(raw_list)[valid_entries],
path_value = unlist(raw_list[valid_entries])
) %>%
mutate(path_abs = path_abs(path_value))
# Check even of het gelukt is
print(head(config_map))
# ==============================================================================
# 3. LOGICA VOOR INPUT/OUTPUT DETECTIE
# ==============================================================================
# Functie om te bepalen of een variabele als Input of Output wordt gebruikt
detect_usage_type <- function(script_content, var_name) {
# Zoek regels waar de variabele in voorkomt
lines_with_var <- script_content[str_detect(script_content, fixed(var_name))]
if (length(lines_with_var) == 0) return(NA)
# Heuristiek: Lijst met functies die typisch schrijven (Output)
write_patterns <- c("write", "save", "ggsave", "png", "pdf", "st_write", "output")
# Heuristiek: Lijst met functies die typisch lezen (Input)
read_patterns  <- c("read", "load", "source", "st_read", "input")
# Check elke regel
is_output <- any(str_detect(lines_with_var, paste(write_patterns, collapse = "|")))
is_input  <- any(str_detect(lines_with_var, paste(read_patterns, collapse = "|")))
if (is_output) return("Output")
if (is_input) return("Input_config")
# Als het in het script staat maar niet duidelijk in een read/write functie:
# Ga er vanuit dat het Input is (bijv. gebruikt in een filter of join)
return("Input_config")
}
# ==============================================================================
# 4. LOOP OVER DE SCRIPTS
# ==============================================================================
# Haal scripts op: XX_naam.R
scripts <- dir_ls(script_dir, regexp = "^\\d{2}_.*\\.R$")
# We werken iteratief: we voegen per script een kolom toe aan df_files
df_result <- df_files
message(paste("Aantal scripts gevonden:", length(scripts)))
for (script_path in scripts) {
script_name <- path_file(script_path)
message(paste("Verwerken:", script_name))
# Lees script tekst
script_content <- readLines(script_path, warn = FALSE)
# Maak een tijdelijke vector voor deze kolom
script_status <- rep(NA_character_, nrow(df_result))
# -- STAP A: Check gebruik via Config Variabelen --
# Welke config variabelen komen voor in dit script?
used_vars <- config_map %>%
rowwise() %>%
filter(any(str_detect(script_content, fixed(var_name)))) %>%
ungroup()
if (nrow(used_vars) > 0) {
for (i in 1:nrow(used_vars)) {
v_name <- used_vars$var_name[i]
v_path <- used_vars$path_abs[i]
# Bepaal type (Input_config of Output)
usage <- detect_usage_type(script_content, v_name)
# Zoek het bestand in de hoofdlijst (match op absoluut pad)
match_idx <- which(df_result$abs_path == v_path)
if (length(match_idx) > 0) {
# Vul in (als er al iets staat, plakken we het erbij, maar meestal is het uniek)
script_status[match_idx] <- usage
}
}
}
# -- STAP B: Check hardcoded paden (Direct Input) --
# We kijken of het relatieve pad van het bestand letterlijk in de tekst staat
# Dit is minder waarschijnlijk met jouw config setup, maar goed voor volledigheid.
for (j in 1:nrow(df_result)) {
# We checken alleen als we nog niets gevonden hebben via config
if (is.na(script_status[j])) {
rel_path <- df_result$path[j]
filename <- path_file(rel_path)
# Simpele check: komt de bestandsnaam voor in quotes?
# (Let op: dit kan false positives geven als bestanden veelvoorkomende namen hebben)
if (any(str_detect(script_content, fixed(filename)))) {
# Simpele aanname: als het hardcoded is, is het vaak input, tenzij in write_...
usage <- detect_usage_type(script_content, filename)
if (!is.na(usage)) {
# Als het via hardcoded string is gevonden, noemen we het "Input" of "Output"
# (Zonder _config suffix)
script_status[j] <- ifelse(usage == "Input_config", "Input", usage)
}
}
}
}
# Voeg de kolom toe aan de dataframe
# We gebruiken dynamische naamgeving (naam van het script)
df_result[[script_name]] <- script_status
}
# ==============================================================================
# 5. OPSLAAN EN RESULTAAT
# ==============================================================================
# Verwijder de hulpkolom 'abs_path' voor de netheid
final_table <- df_result %>% select(-abs_path)
# Opslaan
output_file <- "data_lineage_matrix.csv"
write_csv(final_table, output_file)
message(paste0("\nKlaar! De matrix is opgeslagen als '", output_file, "'"))
# Toon een preview van rijen die daadwerkelijk gebruikt worden in scripts
used_files <- final_table %>%
filter(if_any(ends_with(".R"), ~ !is.na(.)))
print(head(used_files))
