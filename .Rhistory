if (ok) {
moved[[length(moved) + 1]] <- list(src = src, dest = dest)
message("verplaatst: ", p)
} else {
message("Fout bij verplaatsen (controleer permissies): ", p)
}
}
message("Verplaatsing klaar. Controleer data/archive_untracked/ voor de verplaatste bestanden.")
}
message("\nKlaar.")
