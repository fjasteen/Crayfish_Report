# --- 6. Koppeling VHAG (Open Wateren) ---
# Filter data punten die een VHAG hebben
data_vhag_subset <- data %>%
dplyr::filter(!is.na(VHAG))
# Functie: Vind dichtstbijzijnde FC punt binnen dezelfde (of aangrenzende) VHAG
find_nearest_vhag <- function(curr_idx, data_sf, fc_sf) {
# Huidige kreeft locatie
current_feat <- data_sf[curr_idx, ]
# Haal VHAG en eventuele VHAG2 (aangrenzende segmenten) op
target_vhags <- c(current_feat$VHAG)
if("VHAG2" %in% names(current_feat) && !is.null(current_feat$VHAG2[[1]])) {
target_vhags <- c(target_vhags, unlist(current_feat$VHAG2))
}
# Filter FC dataset op deze VHAGs en het juiste jaar
fc_sub <- fc_sf %>%
dplyr::filter(VHAG %in% target_vhags,
year == current_feat$yearGroup)
# Als er geen match is, retourneer NA
if (nrow(fc_sub) == 0) {
return(list(sample_point = NA_character_, distance = NA_real_))
}
# Vind dichtstbijzijnde punt
nearest_idx <- st_nearest_feature(current_feat, fc_sub)
dist <- st_distance(current_feat, fc_sub[nearest_idx, ], by_element = TRUE)
return(list(sample_point = fc_sub$sample_point[nearest_idx], distance = as.numeric(dist)))
}
# Pas de functie toe (kan even duren afhankelijk van dataset grootte)
# Gebruik hier de originele fc_aggregated (als sf object)
results_vhag <- map(1:nrow(data_vhag_subset),
~find_nearest_vhag(.x, data_vhag_subset, fc_aggregated))
# Resultaten uitpakken en toevoegen
data_fc_vhag_linked <- data_vhag_subset %>%
mutate(
sample_point = map_chr(results_vhag, "sample_point"),
distance_cray_FC = map_dbl(results_vhag, "distance")
) %>%
# Filter op matches binnen 1000m (zoals in jouw commentaar) en die gelukt zijn (!is.na)
dplyr::filter(!is.na(sample_point) & distance_cray_FC < 1000)
# Nu de fysicochemische data erbij joinen op basis van het gevonden sample_point + jaar
data_fc_vhag <- data_fc_vhag_linked %>%
left_join(st_drop_geometry(fc_aggregated),
by = c("sample_point", "yearGroup" = "year", "VHAG"),
suffix = c("", "_fc"))
# --- 8. Final Merges ---
# Combineer de datasets
data_fc_cray_combined <- bind_rows(data_fc_wvlc, data_fc_vhag) %>%
# Selecteer relevante kolommen en drop geometrie voor export
st_drop_geometry()
# Export ruwe data (Alle metingen)
write.table(data_fc_cray_combined,
file = here("data", "verwerkt", "data_fc_cray_ruw.txt"),
sep = "\t", row.names = FALSE)
data_fc_cray_combined
write.table(data_fc_cray_final,
file = here("data", "output", "fc_cray_analysis.txt"),
sep = "\t", row.names = FALSE)
# --- 8. Final Merges ---
# Combineer de datasets
data_fc_cray_combined <- bind_rows(data_fc_wvlc, data_fc_vhag) %>%
# Selecteer relevante kolommen en drop geometrie voor export
st_drop_geometry()
# --- 9. Aggregatie naar Mediaan (Zomer) ---
# Zomer filter (Mei - Oktober)
# Zorg dat je een datum of maand kolom hebt. In je tibble zie ik 'date'.
data_zomer <- data_fc_cray_combined %>%
mutate(MaandNr = as.numeric(format(date, "%m"))) %>%
filter(MaandNr %in% 5:10)
# Aggregatie functie
mediancon <- function(x){
if(is.numeric(x)){
median(x, na.rm = TRUE)
} else {
paste(unique(na.omit(x)), collapse = "; ")
}
}
# Groeperen per Kreeft-locatie (ID of locID uit je tibble) en mediaan berekenen
data_fc_cray_final <- data_zomer %>%
group_by(locID, yearGroup) %>% # Of ID als dat unieker is
# Pas aggregatie toe op de FC kolommen (O2, pH, etc.)
# Pas lijst aan op basis van wat er exact in je fc_aggregated zit
summarise(across(c(O2, BZV5, pH, T, EC20, Pt, Nt, Cl, ZS, distance_cray_FC), ~mediancon(.x)),
.groups = "drop")
write.table(data_fc_cray_final,
file = here("data", "output", "fc_cray_analysis.txt"),
sep = "\t", row.names = FALSE)
